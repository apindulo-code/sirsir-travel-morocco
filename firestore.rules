rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /destinations/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /transport_providers/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /travel_news/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phoneNumber',
          'preferredLanguage', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'preferredLanguage', 'updatedAt'
        ]);
      allow delete: if owns(uid);

      match /{subcollection}/{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
