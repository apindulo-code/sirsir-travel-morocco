rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /destinations/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /transport_providers/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /travel_news/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phoneNumber',
          'preferredLanguage', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid;
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'preferredLanguage', 'updatedAt'
        ]);
      allow delete: if owns(uid);

      match /{subcollection}/{document=**} {
        allow read, write: if owns(uid);
      }
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'origin', 'destination', 'travelDate',
          'passengerName', 'passengerPhone', 'providerName',
          'displayedPrice', 'currency', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.origin is string
        && request.resource.data.destination is string
        && request.resource.data.passengerName is string
        && request.resource.data.passengerPhone is string
        && request.resource.data.providerName is string
        && request.resource.data.displayedPrice is number
        && request.resource.data.status == 'requested';
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      // A client can only cancel its own request; it cannot rewrite trip,
      // passenger, provider, price, or ownership fields.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled';
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'subjectId', 'subjectType', 'rating',
          'comment', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'comment'
        ])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
