# Copy to .env for local development. Never commit the real .env file.
GEMINI_API_KEY=replace_with_a_server_side_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
ALLOWED_ORIGIN=http://localhost:3000
PORT=8080
GEMINI_TIMEOUT_MS=30000

# Optional for local development only. In Cloud Run, use the attached service account
# with Application Default Credentials instead of storing a service-account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
